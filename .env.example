# Für netlify/functions/newsletter-signup.js
# Datei zu .env kopieren und mit echten Werten füllen (wird von .gitignore ignoriert).
# Für den Live-Betrieb dieselben Variablen unter Netlify → Site settings →
# Environment variables eintragen.

# Brevo → Einstellungen (Zahnrad oben rechts) → SMTP & API → API-Schlüssel
BREVO_API_KEY=

# Brevo → Kontakte → Listen → temporäre Double-Opt-in-Liste öffnen → ID steht in der URL
BREVO_LIST_ID_TEMP=
