---
const year = new Date().getFullYear();
---

<footer class="mt-fluid-2xl border-t border-ink/10">
  <div class="mx-auto flex max-w-5xl flex-col gap-10 px-6 py-fluid-lg md:flex-row md:items-start md:justify-between">
    <div>
      <p class="font-display text-lg">Henri Wagner</p>
      <p class="mt-1 text-sm text-ink/60">&copy; {year} — Alle Rechte vorbehalten</p>
      <p class="mt-2 text-sm">
        <a href="/datenschutz" class="underline hover:no-underline">Datenschutz</a>
      </p>

      <div class="mt-4 flex gap-4">
        <a
          href="https://www.linkedin.com/in/henri-wagner-ab5056249/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="text-ink/60 hover:text-accent"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zM7.119 20.452H3.554V9h3.565v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
        <a
          href="https://www.instagram.com/11henri9/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-ink/60 hover:text-accent"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.667.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Trägt den Kontakt via netlify/functions/newsletter-signup.js in die temporäre
         Brevo-Liste ein; die dort eingerichtete Automation übernimmt den Rest
         (DOI-Mail versenden, bei Klick in die echte Liste verschieben). -->
    <form id="newsletter-form" class="w-full max-w-sm">
      <label for="newsletter-email" class="block text-sm font-medium">
        Newsletter abonnieren
      </label>
      <div class="mt-2 flex gap-2">
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          placeholder="deine@email.de"
          class="w-full border border-ink/20 bg-transparent px-3 py-2 text-sm outline-none focus:border-ink/50"
        />
        <button
          type="submit"
          class="shrink-0 border border-ink px-4 py-2 text-sm font-medium hover:bg-ink hover:text-paper disabled:opacity-50"
        >
          Anmelden
        </button>
      </div>
      <label class="mt-3 flex items-start gap-2 text-xs text-ink/60">
        <input
          type="checkbox"
          name="consent"
          required
          class="mt-0.5 h-3.5 w-3.5 shrink-0 border-ink/30"
        />
        <span>
          Ich möchte den Newsletter von Henri Wagner erhalten und akzeptiere die
          <a href="/datenschutz" class="underline hover:no-underline">Datenschutzerklärung</a>.
        </span>
      </label>
      <p class="mt-2 text-xs text-ink/50">Kein Spam, jederzeit abbestellbar.</p>
      <p id="newsletter-status" class="mt-2 text-xs" role="status" aria-live="polite"></p>
    </form>
  </div>
</footer>

<script>
  const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
  const status = document.getElementById("newsletter-status");

  if (form && status) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const email = (form.elements.namedItem("email") as HTMLInputElement).value;
      const consent = (form.elements.namedItem("consent") as HTMLInputElement).checked;
      const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
      const originalLabel = button.textContent;

      button.disabled = true;
      button.textContent = "Sende …";
      status.textContent = "";

      try {
        const response = await fetch("/.netlify/functions/newsletter-signup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, consent }),
        });

        if (response.ok) {
          status.textContent =
            "Fast geschafft — bitte bestätige die Anmeldung über den Link in der E-Mail, die gleich bei dir ankommt.";
          status.className = "mt-2 text-xs text-accent";
          form.reset();
        } else {
          const data = await response.json().catch(() => ({}));
          status.textContent = data.error ?? "Anmeldung fehlgeschlagen, bitte später erneut versuchen.";
          status.className = "mt-2 text-xs text-red-700";
        }
      } catch {
        status.textContent = "Anmeldung fehlgeschlagen, bitte später erneut versuchen.";
        status.className = "mt-2 text-xs text-red-700";
      } finally {
        button.disabled = false;
        button.textContent = originalLabel;
      }
    });
  }
</script>
