---
const navItems = [
  { href: "/artikel", label: "Artikel" },
  { href: "/blog", label: "Blog" },
  { href: "/fotografie", label: "Fotografie" },
  { href: "/diverses", label: "Diverses" },
  { href: "/ueber-mich", label: "Über mich" },
];
---

<header class="border-b border-ink/10">
  <div class="mx-auto grid max-w-5xl grid-cols-[1fr_auto_1fr] items-center gap-4 px-6 py-5">
    <a href="/" class="justify-self-start font-brand text-xl text-ink sm:text-2xl">
      Henri Wagner
    </a>

    <a href="/" aria-label="Zur Startseite" class="justify-self-center">
      <img src="/bilder/logo-eule.png" alt="Eulen-Logo" class="h-16 w-auto" />
    </a>

    <div class="relative justify-self-end">
      <!-- Mobile: JS-freies Ausklapp-Menü über <details>/<summary>, als freischwebendes Panel -->
      <details class="md:hidden">
        <summary
          class="cursor-pointer list-none text-sm font-medium select-none [&::-webkit-details-marker]:hidden"
        >
          Menü
        </summary>
        <nav
          aria-label="Hauptnavigation"
          class="absolute right-0 top-full z-30 mt-3 w-48 border border-ink/10 bg-paper p-5 shadow-lg"
        >
          <ul class="flex flex-col gap-4 text-sm">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} class="block hover:underline">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>

      <!-- Desktop: horizontale Navigation -->
      <nav aria-label="Hauptnavigation" class="hidden md:block">
        <ul class="flex gap-8 text-sm">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="hover:underline">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
