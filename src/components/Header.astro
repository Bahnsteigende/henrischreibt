---
const navItems = [
  { href: "/artikel", label: "Artikel" },
  { href: "/blog", label: "Blog" },
  { href: "/fotografie", label: "Fotografie" },
  { href: "/diverses", label: "Diverses" },
  { href: "/ueber-mich", label: "Über mich" },
];
---

<header class="border-b border-ink/10">
  <div class="mx-auto grid max-w-5xl grid-cols-[1fr_auto_1fr] items-center gap-4 px-6 py-fluid-sm">
    <a href="/" class="justify-self-start font-sans text-xl font-bold text-ink sm:text-2xl">
      Henri <span class="text-ink/40">Wagner</span>
    </a>

    <a
      href="/"
      id="owl-logo"
      aria-label="Zur Startseite (Klick für ein kleines Daumenkino)"
      class="justify-self-center"
    >
      <img
        id="owl-logo-img"
        src="/bilder/daumenkino/frame-01.png"
        alt="Eulen-Logo"
        class="h-[4.1rem] w-auto transition hover:scale-105 sm:h-[4.8rem]"
      />
    </a>

    <div class="relative justify-self-end">
      <!-- Mobile: JS-freies Ausklapp-Menü über <details>/<summary>, als freischwebendes Panel -->
      <details class="md:hidden">
        <summary
          class="cursor-pointer list-none text-sm font-medium select-none [&::-webkit-details-marker]:hidden"
        >
          Menü
        </summary>
        <nav
          aria-label="Hauptnavigation"
          class="absolute right-0 top-full z-30 mt-3 w-48 border border-ink/10 bg-paper p-5 shadow-lg"
        >
          <ul class="flex flex-col gap-4 text-sm">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} class="block hover:underline">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>

      <!-- Desktop: horizontale Navigation -->
      <nav aria-label="Hauptnavigation" class="hidden md:block">
        <ul class="flex gap-8 text-sm">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="hover:underline">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const FRAME_COUNT = 11;
  const FRAME_DURATION = 55;
  const framePaths = Array.from(
    { length: FRAME_COUNT },
    (_, i) => `/bilder/daumenkino/frame-${String(i + 1).padStart(2, "0")}.png`,
  );

  const link = document.getElementById("owl-logo") as HTMLAnchorElement | null;
  const img = document.getElementById("owl-logo-img") as HTMLImageElement | null;

  if (link && img) {
    let preloaded = false;
    const preloadFrames = () => {
      if (preloaded) return;
      preloaded = true;
      for (const src of framePaths) {
        const preload = new Image();
        preload.src = src;
      }
    };
    link.addEventListener("pointerenter", preloadFrames, { once: true });
    link.addEventListener("focus", preloadFrames, { once: true });

    let playing = false;
    let expanded = false;

    const playSequence = (forward: boolean) => {
      playing = true;
      const sequence = forward ? framePaths : [...framePaths].reverse();
      let i = 0;
      const step = () => {
        img.src = sequence[i];
        i++;
        if (i < sequence.length) {
          setTimeout(step, FRAME_DURATION);
        } else {
          playing = false;
          expanded = forward;
        }
      };
      step();
    };

    link.addEventListener("click", (event) => {
      event.preventDefault();
      if (playing) return;
      playSequence(!expanded);
    });
  }
</script>
