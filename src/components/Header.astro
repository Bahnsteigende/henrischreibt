---
const navItems = [
  { href: "/schreibportfolio", label: "Schreibportfolio" },
  { href: "/blog", label: "Blog" },
  { href: "/fotografie", label: "Fotografie" },
  { href: "/diverses", label: "Diverses" },
  { href: "/ueber-mich", label: "Über mich" },
  { href: "/kontakt", label: "Kontakt" },
];
---

<header class="border-b border-ink/10">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
    <a href="/" class="font-display text-xl tracking-tight">Henri</a>

    <!-- Mobile: JS-freies Ausklapp-Menü über <details>/<summary> -->
    <details class="md:hidden">
      <summary class="cursor-pointer list-none text-sm font-medium">Menü</summary>
      <nav aria-label="Hauptnavigation">
        <ul class="mt-4 flex flex-col gap-3 text-sm">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="hover:underline">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <!-- Desktop: horizontale Navigation -->
    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex gap-8 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
