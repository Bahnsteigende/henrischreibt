---
const outlets = [
  { name: "Spektrum.de", file: "spektrum.webp" },
  { name: "c't Magazin", file: "C'T_Magazin.png" },
  { name: "Physik Journal", file: "physik-journal.png" },
  { name: "DAV Panorama", file: "dav-panorama.png" },
];
---

<section class="mx-auto max-w-5xl px-6 pb-16">
  <p class="text-center text-sm text-ink/50">Veröffentlicht u. a. in</p>
  <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
    {
      outlets.map((outlet) => (
        <li>
          <img
            src={`/logos/${outlet.file}`}
            alt={outlet.name}
            class="h-7 w-auto mix-blend-multiply grayscale opacity-60 transition hover:opacity-100 hover:grayscale-0"
          />
        </li>
      ))
    }
  </ul>
</section>
