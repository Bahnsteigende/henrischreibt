---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fotografieKategorien } from "../../data/fotografie";
---

<BaseLayout
  title="Fotografie — Henri"
  description="Fotografie aus Hochzeiten & Events, Outdoor und mehr."
>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="font-display text-3xl">Fotografie</h1>
    <p class="mt-4 max-w-2xl text-ink/60">Ein erster Eindruck meiner Arbeit — mehr folgt.</p>

    <div class="mt-16 flex flex-col gap-16">
      {
        fotografieKategorien.map((kategorie) => (
          <div>
            <h2 class="font-display text-2xl">{kategorie.title}</h2>
            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
              {kategorie.images.map((src) => (
                <img
                  src={src}
                  alt={kategorie.title}
                  class="aspect-[4/3] w-full object-cover"
                  loading="lazy"
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
