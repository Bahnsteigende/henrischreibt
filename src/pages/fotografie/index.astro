---
import BaseLayout from "../../layouts/BaseLayout.astro";

const kategorien = [
  { href: "/fotografie/hochzeiten-events", label: "Hochzeiten & Events" },
  { href: "/fotografie/outdoor", label: "Outdoor" },
  { href: "/fotografie/sonstiges", label: "Sonstiges" },
];
---

<BaseLayout title="Fotografie — Henri">
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-display text-3xl">Fotografie</h1>
    <p class="mt-4 text-ink/60">Drei Rubriken, sortiert im Portfolio-Look.</p>
    <ul class="mt-8 flex flex-col gap-2">
      {
        kategorien.map((kat) => (
          <li>
            <a href={kat.href} class="underline hover:no-underline">
              {kat.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
