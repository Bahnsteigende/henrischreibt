---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import corneliusImage from "../assets/site/cornelius-gijsbrechts.jpeg";
import henriOutdoorImage from "../assets/site/henri-outdoor.jpg";

const teasers = [
  {
    href: "/artikel",
    title: "Journalismus & Schreiben",
    text: "Artikel und Texte, veröffentlicht bei verschiedenen Publikationen.",
  },
  {
    href: "/blog",
    title: "Blog",
    text: "Persönliche Geschichten, Gedanken und Reiseberichte.",
  },
  {
    href: "/fotografie",
    title: "Fotografie",
    text: "Bilder aus Hochzeiten & Events, Outdoor und mehr.",
  },
];
---

<BaseLayout>
  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <h1 class="font-display text-3xl md:text-4xl">Willkommen auf der Website von Henri Wagner</h1>
    <p class="mt-4 text-lg text-ink/70">Henri ist freier Journalist, leidenschaftlicher Autor und semiprofessioneller Fotograf.</p>
  </section>

  <section class="mx-auto grid max-w-5xl gap-8 px-6 pb-24 md:grid-cols-3">
    {
      teasers.map((teaser) => (
        <a
          href={teaser.href}
          class="block border border-ink/10 p-6 transition-colors hover:border-ink/30"
        >
          <h2 class="font-display text-xl">{teaser.title}</h2>
          <p class="mt-2 text-sm text-ink/60">{teaser.text}</p>
        </a>
      ))
    }
  </section>

  <section class="mx-auto flex max-w-2xl flex-col gap-10 px-6 pb-24">
    <Image
      src={corneliusImage}
      alt="Cornelis Norbertus Gijsbrechts — Trompe-l'œil, Rückseite eines gerahmten Gemäldes"
      widths={[600, 1000, 1400]}
      sizes="(min-width: 768px) 42rem, 100vw"
      format="webp"
      quality={82}
      loading="lazy"
      class="block w-full"
    />
    <Image
      src={henriOutdoorImage}
      alt="Henri auf dem Fahrrad in den Bergen"
      widths={[600, 1000, 1400]}
      sizes="(min-width: 768px) 42rem, 100vw"
      format="webp"
      quality={82}
      loading="lazy"
      class="block w-full"
    />
  </section>
</BaseLayout>
