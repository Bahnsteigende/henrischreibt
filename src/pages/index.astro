---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import PublishedIn from "../components/PublishedIn.astro";

const teasers = [
  {
    href: "/artikel",
    title: "Journalismus & Schreiben",
    text: "Artikel und Texte, veröffentlicht bei verschiedenen Publikationen.",
  },
  {
    href: "/blog",
    title: "Blog",
    text: "Persönliche Geschichten, Gedanken und Reiseberichte.",
  },
  {
    href: "/fotografie",
    title: "Fotografie",
    text: "Von Hochzeiten zum Bergsteigen und zurück.",
  },
];
---

<BaseLayout>
  <AnnouncementBanner
    text={`Unser Film „Project Green 7“ – Trailer out now!`}
    href="https://youtu.be/-yOgpYQ7kIg?si=v4GWkyPp7RB7XswQ"
  />

  <section class="mx-auto max-w-3xl px-6 py-10 text-center">
    <h1 class="font-display text-2xl md:text-3xl">Journalist, Autor und Fotograf.</h1>
  </section>

  <section class="mx-auto grid max-w-5xl gap-8 px-6 pb-16 md:grid-cols-3">
    {
      teasers.map((teaser) => (
        <a
          href={teaser.href}
          class="block border border-ink/10 p-6 transition-colors hover:border-accent"
        >
          <h2 class="font-display text-xl">{teaser.title}</h2>
          <p class="mt-2 text-sm text-ink/60">{teaser.text}</p>
        </a>
      ))
    }
  </section>

  <PublishedIn />
</BaseLayout>
