---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

const teasers = [
  {
    href: "/artikel",
    title: "Journalismus & Schreiben",
    text: "Artikel und Texte, veröffentlicht bei verschiedenen Publikationen.",
  },
  {
    href: "/blog",
    title: "Blog",
    text: "Persönliche Geschichten, Gedanken und Reiseberichte.",
  },
  {
    href: "/fotografie",
    title: "Fotografie",
    text: "Bilder aus Hochzeiten & Events, Outdoor und mehr.",
  },
];

// Bild ändern: neue Datei nach src/assets/site/ legen und den Dateinamen hier eintragen.
// Die Quellenangabe unter dem Bild wird automatisch aus dem Dateinamen abgeleitet.
// Passt das Bild farblich nicht mehr, die Akzentfarben (--color-accent...) in
// src/styles/global.css von Hand nachziehen.
const heroImageFile = "Cornelius_Nobertus_Gijsbrechts.jpeg";

const siteImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/site/*.{jpg,jpeg,png}",
  { eager: true }
);
const heroImage = siteImages[`/src/assets/site/${heroImageFile}`];
if (!heroImage) throw new Error(`Startseite: Bild nicht gefunden — ${heroImageFile}`);
const heroCaption = heroImageFile.replace(/\.[^.]+$/, "").replace(/[_-]+/g, " ");
---

<BaseLayout>
  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <h1 class="font-display text-3xl md:text-4xl">Willkommen auf der Website von Henri Wagner</h1>
    <p class="mt-4 text-lg text-ink/70">Henri ist freier Journalist, leidenschaftlicher Autor und semiprofessioneller Fotograf.</p>
  </section>

  <section class="mx-auto grid max-w-5xl gap-8 px-6 pb-24 md:grid-cols-3">
    {
      teasers.map((teaser) => (
        <a
          href={teaser.href}
          class="block border border-ink/10 p-6 transition-colors hover:border-accent"
        >
          <h2 class="font-display text-xl">{teaser.title}</h2>
          <p class="mt-2 text-sm text-ink/60">{teaser.text}</p>
        </a>
      ))
    }
  </section>

  <section class="mx-auto max-w-2xl px-6 pb-24">
    <div class="bg-accent-soft/60 p-3 sm:p-5">
      <Image
        src={heroImage.default}
        alt={heroCaption}
        widths={[600, 1000, 1400]}
        sizes="(min-width: 768px) 42rem, 100vw"
        format="webp"
        quality={82}
        loading="lazy"
        class="block w-full"
      />
    </div>
    <p class="mt-3 text-center text-xs text-ink/50 sm:text-sm">Quelle: {heroCaption}</p>
  </section>
</BaseLayout>
