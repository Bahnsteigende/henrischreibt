---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Abo bestätigt — Henri"
  description="Deine Newsletter-Anmeldung ist bestätigt."
>
  <section class="mx-auto max-w-3xl px-6 py-fluid-2xl text-center">
    <p class="text-sm text-ink/50">Newsletter</p>
    <h1 class="mt-2 font-display text-3xl">Danke, du bist dabei.</h1>
    <p class="mt-4 text-ink/70">
      Deine Anmeldung ist bestätigt. Ab jetzt bekommst du Neues aus Journalismus, Blog und
      Fotografie direkt ins Postfach.
    </p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-block border border-ink px-4 py-2 text-sm font-medium hover:bg-ink hover:text-paper"
      >
        Zurück zur Startseite
      </a>
    </p>
  </section>
</BaseLayout>
