---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Content, frontmatter } from "../content/uebermich.md";
---

<BaseLayout title="Über mich — Henri" description="Über Henri — Journalist, Autor und Fotograf.">
  <article class="mx-auto max-w-3xl px-6 py-fluid-xl">
    {
      frontmatter.image && (
        <img
          src={frontmatter.image}
          alt="Henri"
          class="mb-10 aspect-[4/3] w-full object-cover"
        />
      )
    }

    <div class="article-content text-base leading-relaxed text-ink/90">
      <Content />
    </div>

    <div class="mt-16 border-t border-ink/10 pt-10">
      <h2 class="font-display text-xl">Kontakt</h2>
      <p class="mt-3 text-ink/70">
        Schreib mir gerne eine Mail:{" "}
        <a href="mailto:w.henri@gmx.de" class="underline hover:no-underline">
          w.henri@gmx.de
        </a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .article-content :global(p) {
    margin-bottom: 1.25em;
  }
</style>
